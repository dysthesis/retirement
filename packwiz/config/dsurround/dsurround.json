{
  // Experimental: skip particle batch repair state queries. Re-enable if particles corrupt.
  "diagnostics": {
    "guards": {
      "repairParticleBatches": false
    }
  },
  // Photon and Voxy own fog for both nearby and distant terrain.
  "fogOptions": {
    "enableFogEffects": false
  },
  // Leave cloud rendering to Sodium/Voxy or the active shader pack.
  "weatherOptions": {
    "enableGroundFog": false,
    "enableDynamicClouds": false
  },
  // Sound Physics Remastered owns reverb and occlusion.
  "enhancedSounds": {
    "enableEnhancedSounds": false
  },
  // Particular supplies water ripples, waterfall particles and fireflies.
  "blockEffects": {
    // Limit environmental block-effect scans; keep nearby effects.
    "blockEffectRange": 24,
    "waterRippleStyle": "NONE"
  },
  "waterfallOptions": {
    "enableParticles": false
  },
  "fireflyOptions": {
    "enableFireflies": false
  }
}
