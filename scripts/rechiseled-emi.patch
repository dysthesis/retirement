+package dev.retirement.emirechiseled;
+
+import com.supermartijn642.rechiseled.Rechiseled;
+import com.supermartijn642.rechiseled.api.chiseling.ChiselingBlockShape;
+import com.supermartijn642.rechiseled.api.chiseling.ChiselingRecipe;
+import com.supermartijn642.rechiseled.api.chiseling.ItemWithWorth;
+import com.supermartijn642.rechiseled.api.chiseling.plugin.ChiselingRecipePlugin;
+import com.supermartijn642.rechiseled.api.chiseling.plugin.RechiseledChiselingRecipePlugin;
+import dev.emi.emi.api.EmiEntrypoint;
+import com.supermartijn642.rechiseled.api.chiseling.plugin.ChiselingRecipesLoadedContext;
+import dev.emi.emi.api.EmiPlugin;
+import dev.emi.emi.api.EmiRegistry;
+import dev.emi.emi.api.recipe.BasicEmiRecipe;
+import dev.emi.emi.api.recipe.EmiRecipeCategory;
+import dev.emi.emi.api.render.EmiTexture;
+import dev.emi.emi.api.stack.EmiIngredient;
+import dev.emi.emi.api.stack.EmiStack;
+import dev.emi.emi.api.widget.WidgetHolder;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.fml.common.Mod;
+import net.neoforged.neoforge.client.event.ClientPlayerNetworkEvent;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.network.chat.Component;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.world.item.Item;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+
+@Mod(value = "emi_rechiseled", dist = Dist.CLIENT)
+@EventBusSubscriber(modid = "emi_rechiseled", value = Dist.CLIENT)
+@EmiEntrypoint
+@RechiseledChiselingRecipePlugin(identifier = "chiseling")
+public final class RechiseledEmiPlugin implements EmiPlugin, ChiselingRecipePlugin {
+    private static volatile List<ChiselingRecipe> syncedRecipes = List.of();
+
+    @SubscribeEvent
+    public static void onDisconnect(ClientPlayerNetworkEvent.LoggingOut event) {
+        syncedRecipes = List.of();
+    }
+
+    @Override
+    public void onRecipesLoaded(ChiselingRecipesLoadedContext context) {
+        if (context.isClient()) {
+            // Rechiseled 1.2.6 sends this before vanilla recipe/tag sync, which reloads EMI.
+            syncedRecipes = context.getRecipeManager().getAllRecipes();
+        }
+    }
+
+    @Override
+    public void register(EmiRegistry registry) {
+        var snapshot = syncedRecipes;
+        var chisel = EmiStack.of(Rechiseled.chisel);
+        var category = new EmiRecipeCategory(ResourceLocation.fromNamespaceAndPath("rechiseled", "chiseling"), chisel) {
+            @Override
+            public Component getName() {
+                return Component.translatable("rechiseled.recipe_category.title");
+            }
+        };
+        registry.addCategory(category);
+        registry.addWorkstation(category, chisel);
+        for (var family : snapshot) {
+            var items = new LinkedHashMap<Item, ItemWithWorth>();
+            for (var shape : ChiselingBlockShape.values()) {
+                for (var entry : family.entries()) {
+                    var regular = entry.getRegularItem(shape);
+                    if (regular != null) {
+                        items.putIfAbsent(regular.item(), regular);
+                    }
+                    var connecting = entry.getConnectingItem(shape);
+                    if (connecting != null) {
+                        items.putIfAbsent(connecting.item(), connecting);
+                    }
+                }
+            }
+            for (var target : items.values()) {
+                var groups = new LinkedHashMap<ConversionAmounts, List<EmiStack>>();
+                for (var source : items.values()) {
+                    if (source.item() == target.item()) {
+                        continue;
+                    }
+                    var amounts = ConversionAmounts.minimum(source, target,
+                            source.item().getDefaultMaxStackSize(), target.item().getDefaultMaxStackSize());
+                    if (amounts != null) {
+                        groups.computeIfAbsent(amounts, key -> new ArrayList<>()).add(EmiStack.of(source.item()));
+                    }
+                }
+                groups.forEach((amounts, alternatives) -> registry.addRecipe(new ChiselingEmiRecipe(category,
+                        EmiIngredient.of(alternatives, amounts.input()), target.item(), amounts.output())));
+            }
+        }
+    }
+
+    private static final class ChiselingEmiRecipe extends BasicEmiRecipe {
+        private ChiselingEmiRecipe(EmiRecipeCategory category, EmiIngredient input, Item output, int count) {
+            super(category, recipeId(input, output, count), 96, 18);
+            inputs.add(input);
+            catalysts.add(EmiStack.of(Rechiseled.chisel));
+            outputs.add(EmiStack.of(output, count));
+        }
+
+        private static ResourceLocation recipeId(EmiIngredient input, Item output, int count) {
+            var itemId = BuiltInRegistries.ITEM.getKey(output);
+            return ResourceLocation.fromNamespaceAndPath("emi_rechiseled", "chiseling/" + itemId.getNamespace()
+                    + "/" + itemId.getPath() + "/" + input.getAmount() + "_" + count);
+        }
+
+        @Override
+        public void addWidgets(WidgetHolder widgets) {
+            widgets.addSlot(inputs.getFirst(), 0, 0);
+            widgets.addSlot(catalysts.getFirst(), 22, 0);
+            widgets.addTexture(EmiTexture.EMPTY_ARROW, 44, 0);
+            widgets.addSlot(outputs.getFirst(), 76, 0).recipeContext(this);
+        }
+    }
+}
