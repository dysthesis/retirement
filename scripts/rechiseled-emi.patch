+package dev.retirement.emirechiseled;
+
+import com.supermartijn642.rechiseled.api.chiseling.ItemWithWorth;
+import com.supermartijn642.rechiseled.api.chiseling.conversion.ChiselingConversionHelper;
+import net.minecraft.world.item.Item;
+
+public final class RecipeSemanticsCheck {
+    public static void main(String[] args) {
+        expect(1, 1, 1, 1);
+        expect(1, 0.5f, 1, 2);
+        expect(0.5f, 1, 2, 1);
+        expect(0.5f, 0.75f, 3, 2);
+        expect(0.75f, 0.5f, 1, 2); // The pinned native helper rounds this conversion up.
+        assert ConversionAmounts.minimum(new Worth(0.5f), new Worth(1), 1, 64) == null;
+        assert ConversionAmounts.minimum(new Worth(1), new Worth(0.5f), 64, 1) == null;
+        for (float source : new float[]{0.5f, 0.75f, 1, 2}) {
+            for (float target : new float[]{0.5f, 0.75f, 1, 2}) {
+                var from = new Worth(source);
+                var to = new Worth(target);
+                var amounts = ConversionAmounts.minimum(from, to, 64, 64);
+                assert amounts != null;
+                var nativeResult = ChiselingConversionHelper.convert(amounts.input(), from, to, 64);
+                assert nativeResult.leftover() == 0;
+                assert nativeResult.numberOfConversions() == amounts.input();
+                assert nativeResult.result() == amounts.output();
+                for (int less = 1; less < amounts.input(); less++) {
+                    var smaller = ChiselingConversionHelper.convert(less, from, to, 64);
+                    assert smaller.leftover() != 0 || smaller.result() == 0;
+                }
+            }
+        }
+        System.out.println("Native chiseling ratios: identity, slab/block, fractional worth, rounding, stack limits and minimal batches passed");
+    }
+
+    private static void expect(float source, float target, int input, int output) {
+        assert new ConversionAmounts(input, output).equals(
+                ConversionAmounts.minimum(new Worth(source), new Worth(target), 64, 64));
+    }
+
+    private record Worth(float worth) implements ItemWithWorth {
+        @Override
+        public Item item() {
+            throw new AssertionError("Quantity calculation must not inspect or initialize Minecraft items");
+        }
+    }
+}
