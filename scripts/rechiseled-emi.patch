+package dev.retirement.emirechiseled;
+
+import com.supermartijn642.rechiseled.api.chiseling.ItemWithWorth;
+import com.supermartijn642.rechiseled.api.chiseling.conversion.ChiselingConversionHelper;
+
+record ConversionAmounts(int input, int output) {
+    static ConversionAmounts minimum(ItemWithWorth source, ItemWithWorth target, int maxInput, int maxOutput) {
+        for (int input = 1; input <= maxInput; input++) {
+            var result = ChiselingConversionHelper.convert(input, source, target, maxOutput);
+            if (result.leftover() == 0 && result.numberOfConversions() == input && result.result() > 0) {
+                return new ConversionAmounts(input, result.result());
+            }
+        }
+        return null;
+    }
+}
