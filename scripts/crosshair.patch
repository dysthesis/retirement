diff --git a/CrosshairAddons/src/test/java/walksy/crosshairaddons/CheckBlitSpriteContract.java b/CrosshairAddons/src/test/java/walksy/crosshairaddons/CheckBlitSpriteContract.java
new file mode 100644
--- /dev/null
+++ b/CrosshairAddons/src/test/java/walksy/crosshairaddons/CheckBlitSpriteContract.java
@@ -0,0 +1,68 @@
+package walksy.crosshairaddons;
+
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.tree.AnnotationNode;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import org.objectweb.asm.tree.MethodNode;
+
+import java.io.InputStream;
+import java.util.List;
+
+public final class CheckBlitSpriteContract {
+    private static ClassNode read(String name) throws Exception {
+        try (InputStream input = ClassLoader.getSystemResourceAsStream(name + ".class")) {
+            if (input == null) throw new AssertionError("Missing real class " + name);
+            ClassNode node = new ClassNode();
+            new ClassReader(input).accept(node, 0);
+            return node;
+        }
+    }
+
+    private static MethodNode method(ClassNode owner, String name, String descriptor) {
+        return owner.methods.stream()
+                .filter(method -> method.name.equals(name) && method.desc.equals(descriptor))
+                .findFirst().orElseThrow(() -> new AssertionError(owner.name + "." + name + descriptor));
+    }
+
+    private static boolean invokes(MethodNode caller, String owner, String name, String descriptor) {
+        for (var instruction : caller.instructions) {
+            if (instruction instanceof MethodInsnNode call && call.owner.equals(owner)
+                    && call.name.equals(name) && call.desc.equals(descriptor)) return true;
+        }
+        return false;
+    }
+
+    public static void main(String[] args) throws Exception {
+        ClassNode graphics = read("net/minecraft/client/gui/GuiGraphics");
+        ClassNode gui = read("net/minecraft/client/gui/Gui");
+        ClassNode mixin = read("walksy/crosshairaddons/mixin/GuiGraphicsExtractorMixin");
+        MethodNode crosshair = method(gui, "renderCrosshair",
+                "(Lnet/minecraft/client/gui/GuiGraphics;Lnet/minecraft/client/DeltaTracker;)V");
+        int checked = 0;
+        for (MethodNode handler : mixin.methods) {
+            if (handler.visibleAnnotations == null) continue;
+            for (AnnotationNode annotation : handler.visibleAnnotations) {
+                if (!annotation.desc.equals("Lorg/spongepowered/asm/mixin/injection/Inject;")) continue;
+                int index = annotation.values.indexOf("method");
+                List<?> targets = (List<?>) annotation.values.get(index + 1);
+                if (targets.size() != 1) throw new AssertionError("Ambiguous injection");
+                String target = (String) targets.getFirst();
+                String descriptor = target.substring(target.indexOf('('));
+                method(graphics, "blitSprite", descriptor);
+                method(mixin, "blitSprite", descriptor);
+                String callback = descriptor.substring(0, descriptor.length() - 2)
+                        + "Lorg/spongepowered/asm/mixin/injection/callback/CallbackInfo;)V";
+                if (!handler.desc.equals(callback)) throw new AssertionError("Callback mismatch: " + handler.desc);
+                if (!invokes(crosshair, graphics.name, "blitSprite", descriptor))
+                    throw new AssertionError("Injection misses the real HUD call: " + target);
+                if (!invokes(handler, mixin.name, "blitSprite", descriptor))
+                    throw new AssertionError("Redraw changes overload: " + target);
+                System.out.println(handler.name + handler.desc + " matches HUD " + target);
+                checked++;
+            }
+        }
+        if (checked != 2) throw new AssertionError("Expected both full/background and progress injections");
+        System.out.println("Real 1.21.1 HUD/target/callback/redraw contracts passed");
+    }
+}
