@@ -0,0 +1,76 @@
+package com.pandaismyname1.emiletsdocompat;
+
+import com.pandaismyname1.emiletsdocompat.herbalbrews.TeaKettleBrewingRecipe;
+import dev.emi.emi.api.recipe.EmiRecipeCategory;
+import dev.emi.emi.api.stack.EmiIngredient;
+import dev.emi.emi.api.stack.EmiStack;
+import dev.emi.emi.api.widget.SlotWidget;
+import dev.emi.emi.api.widget.Widget;
+import dev.emi.emi.api.widget.WidgetHolder;
+import dev.emi.emi.bom.MaterialNode;
+import net.minecraft.SharedConstants;
+import net.minecraft.core.NonNullList;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.item.crafting.Ingredient;
+import net.satisfy.herbalbrews.core.recipe.TeaKettleRecipe;
+import net.satisfy.herbalbrews.core.registry.TagsRegistry;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+public final class RecipeSemanticsCheck {
+    public static void main(String[] args) {
+        SharedConstants.tryDetectVersion();
+        // Bootstrap vanilla-only registries for this standalone native semantic check.
+        net.neoforged.fml.loading.LoadingModList.of(
+                List.of(), List.of(), List.of(), List.of(), Map.of());
+        Bootstrap.bootStrap();
+        // Give the native container tag a second valid container to catch broadening of a recipe's bottle ingredient.
+        BuiltInRegistries.ITEM.bindTags(Map.of(TagsRegistry.CONTAINER_ITEMS,
+                List.of(Items.GLASS_BOTTLE.builtInRegistryHolder(), Items.BOWL.builtInRegistryHolder())));
+        checkContainer(Ingredient.of(Items.GLASS_BOTTLE), 1);
+        checkContainer(Ingredient.of(Items.GLASS_BOTTLE, Items.BOWL), 2);
+        System.out.println("PASS: real kettle inputs, bottle widgets and EMI material nodes retain exact consumed containers");
+    }
+
+    private static void checkContainer(Ingredient container, int alternatives) {
+        var ingredients = NonNullList.of(Ingredient.EMPTY,
+                Ingredient.of(Items.KELP), Ingredient.of(Items.SUGAR), container);
+        var nativeRecipe = new TeaKettleRecipe(ingredients, new ItemStack(Items.POTION),
+                ResourceLocation.fromNamespaceAndPath("minecraft", "speed"), 1800, 10, 50, 20, 0.8f);
+        var category = new EmiRecipeCategory(ResourceLocation.fromNamespaceAndPath("herbalbrews", "cooking"), EmiStack.EMPTY);
+        var recipe = new TeaKettleBrewingRecipe(category, nativeRecipe);
+        assert recipe.getInputs().size() == 3 : "Consumed container was omitted from the recipe inputs";
+        EmiIngredient bottle = recipe.getInputs().get(2);
+        assert bottle.getEmiStacks().size() == alternatives : "Container alternatives must match the native ingredient";
+        assert bottle.getAmount() == 1;
+        assert bottle.getEmiStacks().stream().anyMatch(stack -> stack.getKey() == Items.GLASS_BOTTLE);
+
+        var material = new MaterialNode(recipe.getOutputs().get(0));
+        material.defineRecipe(recipe);
+        assert material.children.size() == 3 : "EMI material planning lost a consumed ingredient";
+        var plannedBottle = material.children.stream()
+                .filter(node -> node.ingredient.getEmiStacks().stream().anyMatch(stack -> stack.getKey() == Items.GLASS_BOTTLE))
+                .findFirst().orElseThrow(() -> new AssertionError("Glass bottle absent from EMI material plan"));
+        assert plannedBottle.amount == 1 && !plannedBottle.catalyst : "The bottle is consumed, not reusable";
+
+        var widgets = new ArrayList<Widget>();
+        recipe.addWidgets(new WidgetHolder() {
+            @Override public int getWidth() { return recipe.getDisplayWidth(); }
+            @Override public int getHeight() { return recipe.getDisplayHeight(); }
+            @Override public <T extends Widget> T add(T widget) { widgets.add(widget); return widget; }
+        });
+        var slots = widgets.stream().filter(SlotWidget.class::isInstance).map(SlotWidget.class::cast).toList();
+        var bottleSlot = slots.stream().filter(slot -> slot.getBounds().x() == 20 && slot.getBounds().y() == 42)
+                .findFirst().orElseThrow();
+        assert bottleSlot.getStack() == bottle : "Bottle widget must use the exact consumed ingredient";
+        assert slots.stream().filter(slot -> slot.getBounds().x() < 40 && slot.getBounds().y() < 40)
+                .noneMatch(slot -> slot.getStack() == bottle) : "Bottle must not occupy an upper brewing slot";
+        assert slots.stream().filter(slot -> slot.getBounds().x() < 40 && slot.getBounds().y() < 40).count() == 2;
+    }
+}
