+package me.cortex.voxy.client.core.model;
+
+import net.minecraft.SharedConstants;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.LiquidBlock;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.properties.BlockStateProperties;
+import java.util.List;
+import java.util.Map;
+
+public final class FluidBlockRegression {
+    public static void main(String[] args) {
+        SharedConstants.tryDetectVersion();
+        // Bootstrap vanilla-only registries for this standalone native semantic check.
+        net.neoforged.fml.loading.LoadingModList.of(
+                List.of(), List.of(), List.of(), List.of(), Map.of());
+        Bootstrap.bootStrap();
+        checkVanilla();
+    }
+
+    public static void checkVanilla() {
+        for (var block : new net.minecraft.world.level.block.Block[]{Blocks.WATER, Blocks.LAVA}) {
+            for (var state : block.getStateDefinition().getPossibleStates()) {
+                assert ModelFactory.isFluidBlock(state) : state;
+            }
+        }
+        assert !ModelFactory.isFluidBlock(Blocks.AIR.defaultBlockState());
+        assert !ModelFactory.isFluidBlock(Blocks.STONE.defaultBlockState());
+        var stairs = Blocks.OAK_STAIRS.defaultBlockState();
+        assert !ModelFactory.isFluidBlock(stairs);
+        var waterlogged = stairs.setValue(BlockStateProperties.WATERLOGGED, true);
+        assert !ModelFactory.isFluidBlock(waterlogged) : waterlogged;
+        var dependency = waterlogged.getFluidState().createLegacyBlock();
+        assert dependency.is(Blocks.WATER) : dependency;
+        assert ModelFactory.isFluidBlock(dependency) : dependency;
+    }
+
+    // Run with assertions enabled from the live modded client; vanilla bootstrap has no Supplementaries registry.
+    public static void checkLumisene() {
+        var block = BuiltInRegistries.BLOCK.getOptional(ResourceLocation.fromNamespaceAndPath("supplementaries", "lumisene")).orElseThrow();
+        assert !(block instanceof LiquidBlock);
+        var state = block.defaultBlockState();
+        assert ModelFactory.isFluidBlock(state) : state;
+        var age = block.getStateDefinition().getProperty("age");
+        assert age != null;
+        var aged = state.setValue((net.minecraft.world.level.block.state.properties.IntegerProperty) age, 5);
+        assert aged != state;
+        assert aged.getFluidState().createLegacyBlock().getBlock() == block;
+        assert aged.getFluidState().createLegacyBlock() != aged;
+        assert ModelFactory.isFluidBlock(aged) : aged;
+    }
+}
